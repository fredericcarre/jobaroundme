# Clé serveur restreinte aux API Places, Routes et Geocoding.
GOOGLE_MAPS_SERVER_API_KEY=

# Clé navigateur restreinte par référent HTTP à la Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# Jeton serveur optionnel de l'API La bonne alternance.
# Création : https://api.apprentissage.beta.gouv.fr/compte/profil
LBA_API_KEY=

# Le scan est actif par défaut en mode live. Passez à false pour le couper.
ENABLE_SITE_SCAN=true

# Nombre maximal d'entreprises dont le site connu est contrôlé par recherche (1 à 40).
# À 40, tous les sites du budget maximal sont analysés lorsqu'ils sont disponibles.
SITE_SCAN_LIMIT=40

# Plafond global appliqué avant le calcul des trajets et le scan (1 à 40).
SEARCH_MAX_EMPLOYERS=40
# Nombre maximal de recherches réelles exécutées simultanément par instance (1 à 20).
SEARCH_MAX_CONCURRENT_SEARCHES=6

# En-tête contenant exactement une IP, supprimé puis réécrit par votre proxy de confiance.
# Exemple après configuration du proxy : x-forwarded-for. Vide, tous les clients
# sans attribution partagent volontairement le même quota.
TRUSTED_CLIENT_IP_HEADER=
